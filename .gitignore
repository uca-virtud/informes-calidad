__pycache__/
.DS_Store

# Configuración personal del IDE
.idea/
*.iml

# Documentos internos que no se versionan
docs/peticiones-cartera/
samples/
old-skills/

# Materiales del Servicio de Calidad con datos personales: revisiones comentadas (autoría
# de los comentarios) y censos del PTGAS
docs/calidad-2026/revisiones/
docs/calidad-2026/censos-ptgas/

# De evals/ se versionan los casos y las ejecuciones; el historial y las valoraciones
# de las coordinaciones (comentarios y rol de quien valora) siguen en local
evals/*
!evals/casos/
!evals/casos.csv
!evals/ejecuciones/
evals/ejecuciones/*/valoracion-coordinacion*.xlsx
evals/ejecuciones/*/valoracion.json
